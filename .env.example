# Copy this file to ".env" and fill in what you need.

# ── AI ────────────────────────────────────────────────
# REQUIRED before inviting the public. Create one at https://console.anthropic.com/settings/keys
# Without it, the AI runs on your personal Claude subscription via Claude Code —
# fine for testing on your own computer, not for serving other people.
ANTHROPIC_API_KEY=sk-ant-paste-your-key-here

# auto (default: API key if set, else subscription) | api | subscription | mock
AI_MODE=auto
ANTHROPIC_MODEL=claude-sonnet-4-5

# ── Site ──────────────────────────────────────────────
PORT=3000
# Who can change the API key / model from inside the app (comma separated).
# If empty, the first account ever created is the owner.
OWNER_EMAILS=hagaydardik@gmail.com

# Only needed if the pages are hosted somewhere else than the server (e.g. Netlify):
# ALLOWED_ORIGINS=https://your-site.netlify.app
# CROSS_ORIGIN=true
